<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="demo_model_2_portal_view_form" model="ir.ui.view">
        <field name="name">demo_model_2_portal_form</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <form string="Connection">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="demo_many2one_dst" string="Destination" />
                    </group>
                    <group>
                        <field name="demo_many2one_src" string="Source" />
                    </group>
                    <group>
                        <field name="diagram_id" />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="demo_model_2_portal_view_graph" model="ir.ui.view">
        <field name="name">demo_model_2_portal_graph</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <graph string="Connections">
                <field name="name" type="row" />
                <field name="demo_many2one_dst" string="Destination" type="row" />
                <field name="demo_many2one_src" string="Source" type="row" />
                <field name="diagram_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="demo_model_2_portal_view_kanban" model="ir.ui.view">
        <field name="name">demo_model_2_portal_kanban</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="demo_many2one_dst" />
                <field name="demo_many2one_src" />
                <field name="diagram_id" />
                <field name="label_diagram" />
                <field name="label_source" />
                <field name="label_destination" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="ms-3 mb-1">
                                <strong><field name="name" /></strong>&#160;
                            </div>
                            <ul>
                                <li><t t-esc="record.label_destination.value"/>: <field name="demo_many2one_dst" /></li>
                                <li><t t-esc="record.label_source.value"/>: <field name="demo_many2one_src" /></li>
                                <li><t t-esc="record.label_diagram.value"/>: <field name="diagram_id" /></li>
                            </ul>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="demo_model_2_portal_view_pivot" model="ir.ui.view">
        <field name="name">demo_model_2_portal_pivot</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <pivot string="Connections">
                <field name="name" type="row" />
                <field name="demo_many2one_dst" string="Destination" type="row" />
                <field name="demo_many2one_src" string="Source" type="row" />
                <field name="diagram_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="demo_model_2_portal_view_search" model="ir.ui.view">
        <field name="name">demo_model_2_portal_search</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <search string="Connections">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
                <filter domain="[('demo_many2one_dst','!=',False)]" name="demo_many2one_dst" string="Destination" />
                <filter domain="[('demo_many2one_src','!=',False)]" name="demo_many2one_src" string="Source" />
                <filter domain="[('diagram_id','!=',False)]" name="diagram_id" string="Diagram" />
            </search>
        </field>
    </record>

    <record id="demo_model_2_portal_view_tree" model="ir.ui.view">
        <field name="name">demo_model_2_portal_tree</field>
        <field name="model">demo.model_2.portal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="demo_many2one_dst" string="Destination"/>
                <field name="demo_many2one_src" string="Source"/>
                <field name="diagram_id"/>
            </list>
        </field>
    </record>

    <record id="demo_model_2_portal_demo_model_2_portal_action_window" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">demo.model_2.portal</field>
        <field name="view_mode">kanban,list,pivot,graph,form,activity</field>
    </record>
</odoo>
