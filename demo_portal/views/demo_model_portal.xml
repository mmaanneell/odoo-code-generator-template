<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="demo_model_portal_view_calendar" model="ir.ui.view">
        <field name="name">demo_model_portal_calendar</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <calendar color="name" date_start="demo_date_time" string="Nodes">
                <field name="name" />
                <field name="demo_binary" />
                <field name="demo_binary_image" widget="image" />
                <field name="demo_boolean" />
                <field name="demo_char" />
                <field name="demo_date" />
                <field name="demo_date_time" />
                <field name="demo_external_link" widget="link_button" />
                <field name="demo_float" />
                <field name="demo_float_time" widget="float_time" />
                <field name="demo_html" />
                <field name="demo_integer" />
                <field name="demo_many2many" />
                <field name="demo_selection" />
                <field name="demo_text" />
                <field name="diagram_id" />
                <field name="xpos" />
                <field name="ypos" />
                <field name="demo_one2many_dst" />
                <field name="demo_one2many_src" />
            </calendar>
        </field>
    </record>

    <record id="demo_model_portal_view_form" model="ir.ui.view">
        <field name="name">demo_model_portal_form</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <form string="Node">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="diagram_id" help="The diagram this node belongs to." />
                    </group>
                    <group string="Diagram Position">
                        <field name="xpos" help="Horizontal position of this node in the diagram canvas." />
                        <field name="ypos" help="Vertical position of this node in the diagram canvas." />
                    </group>
                    <group string="Connections">
                        <field name="demo_one2many_dst" help="Connections where this node is the source (arrows going out)." />
                        <field name="demo_one2many_src" help="Connections where this node is the destination (arrows coming in)." />
                    </group>
                    <group string="Demo Fields">
                        <field name="demo_char" />
                        <field name="demo_boolean" />
                        <field name="demo_integer" />
                        <field name="demo_float" />
                        <field name="demo_float_time" widget="float_time" />
                        <field name="demo_date" />
                        <field name="demo_date_time" />
                        <field name="demo_selection" />
                    </group>
                    <group string="Other">
                        <field name="demo_binary" />
                        <field name="demo_binary_image" widget="image" />
                        <field name="demo_external_link" />
                        <field name="demo_many2many" />
                    </group>
                    <group>
                        <field name="demo_text" />
                    </group>
                    <group>
                        <field name="demo_html" />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="demo_model_portal_view_graph" model="ir.ui.view">
        <field name="name">demo_model_portal_graph</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <graph string="Nodes">
                <field name="name" type="row" />
                <field name="demo_boolean" type="row" />
                <field name="demo_char" type="row" />
                <field name="demo_date" type="row" />
                <field name="demo_date_time" type="row" />
                <field name="demo_selection" type="row" />
                <field name="diagram_id" type="row" />
                <field name="demo_float" type="measure" />
                <field name="demo_float_time" type="measure" />
                <field name="demo_integer" type="measure" />
                <field name="xpos" type="measure" />
                <field name="ypos" type="measure" />
            </graph>
        </field>
    </record>

    <record id="demo_model_portal_view_kanban" model="ir.ui.view">
        <field name="name">demo_model_portal_kanban</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="diagram_id" />
                <field name="demo_one2many_dst" />
                <field name="demo_one2many_src" />
                <field name="label_diagram" />
                <field name="label_source" />
                <field name="label_destination" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="ms-3 mb-1">
                                <strong><field name="name" /></strong>&#160;
                            </div>
                            <ul>
                                <li><t t-esc="record.label_diagram.value"/>: <field name="diagram_id" /></li>
                                <li><t t-esc="record.label_source.value"/>: <field name="demo_one2many_dst" /></li>
                                <li><t t-esc="record.label_destination.value"/>: <field name="demo_one2many_src" /></li>
                            </ul>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="demo_model_portal_view_pivot" model="ir.ui.view">
        <field name="name">demo_model_portal_pivot</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <pivot string="Nodes">
                <field name="name" type="row" />
                <field name="demo_boolean" type="row" />
                <field name="demo_char" type="row" />
                <field name="demo_date" type="row" />
                <field name="demo_selection" type="row" />
                <field name="diagram_id" type="row" />
                <field name="demo_float" type="measure" />
                <field name="demo_float_time" type="measure" />
                <field name="demo_integer" type="measure" />
                <field name="xpos" type="measure" />
                <field name="ypos" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="demo_model_portal_view_search" model="ir.ui.view">
        <field name="name">demo_model_portal_search</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <search string="Nodes">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
                <filter domain="[('demo_char','!=',False)]" name="demo_char" string="Char" />
                <filter domain="[('demo_boolean','=',True)]" name="demo_boolean" string="Boolean" />
                <filter domain="[('demo_date','!=',False)]" name="demo_date" string="Date" />
                <filter domain="[('demo_date_time','!=',False)]" name="demo_date_time" string="Datetime" />
                <filter domain="[('demo_float','!=',False)]" name="demo_float" string="Float" />
                <filter domain="[('demo_integer','!=',False)]" name="demo_integer" string="Integer" />
                <filter domain="[('demo_selection','!=',False)]" name="demo_selection" string="Selection" />
                <filter domain="[('diagram_id','!=',False)]" name="diagram_id" string="Diagram" />
                <filter domain="[('demo_one2many_dst','!=',False)]" name="demo_one2many_dst" string="Outgoing Connections" />
                <filter domain="[('demo_one2many_src','!=',False)]" name="demo_one2many_src" string="Incoming Connections" />
            </search>
        </field>
    </record>

    <record id="demo_model_portal_view_timeline" model="ir.ui.view">
        <field name="name">demo_model_portal_timeline</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <timeline
                date_start="demo_date_time"
                date_stop="demo_date"
                default_group_by="name"
                event_open_popup="True"
                string="Nodes"
            />
        </field>
    </record>

    <record id="demo_model_portal_view_tree" model="ir.ui.view">
        <field name="name">demo_model_portal_tree</field>
        <field name="model">demo.model.portal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="diagram_id" />
                <field name="demo_one2many_dst" />
                <field name="demo_one2many_src" />
            </list>
        </field>
    </record>

    <record id="demo_model_portal_demo_model_portal_action_window" model="ir.actions.act_window">
        <field name="name">Nodes</field>
        <field name="res_model">demo.model.portal</field>
        <field name="view_mode">kanban,list,timeline,pivot,graph,form,calendar,activity</field>
    </record>
</odoo>
